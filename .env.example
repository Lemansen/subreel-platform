# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Серверные секреты (service_role и т.п.) сюда не добавлять с префиксом NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
# Generate a random secret (at least 16 characters) and set the same value in Vercel.
CRON_SECRET=replace-with-a-long-random-secret
# TMDB → account settings → API → API Read Access Token (server-only)
TMDB_API_READ_ACCESS_TOKEN=your-tmdb-api-read-access-token
# CurseForge third-party API key (server-only; apply at CurseForge for Studios)
CURSEFORGE_API_KEY=your-curseforge-api-key
# DeepL API key for authenticated launcher catalog translations (server-only)
DEEPL_AUTH_KEY=your-deepl-api-key
# Optional for DeepL Pro; defaults to the Free API host
DEEPL_API_URL=https://api-free.deepl.com
# Optional exact-host allowlists for manually imported custom providers (comma-separated, no scheme/path).
# Leave empty to reject custom-provider source/media URLs.
CATALOG_IMPORT_ALLOWED_CUSTOM_SOURCE_HOSTS=
CATALOG_IMPORT_ALLOWED_CUSTOM_MEDIA_HOSTS=
